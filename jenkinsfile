pipeline {
    agent any
    
    environment {
        DOCKERHUB_REPO = 'nwudofidelis/jenkins-image'
        DOCKERHUB_CREDS = credentials('DockerHubCred-ID')
    }

    stages {
        stage('Source') {
            steps {
                echo 'Login to GitHub account'
                git branch: 'main', credentialsId: 'GitHub-cred-ID', url: 'https://github.com/nwudochika/jenkins-docker-pipeline.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building docker image'
                sh 'whoami'
                sh 'docker build -t ${DOCKERHUB_REPO}:v${BUILD_NUMBER} .'
                sh 'docker images'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying image to dockerhub'
                sh 'docker login -u ${DOCKERHUB_CREDS_USR} -p ${DOCKERHUB_CREDS_PSW}'
                sh 'docker push ${DOCKERHUB_REPO}:v${BUILD_NUMBER}'
            }
        }
    }
}
